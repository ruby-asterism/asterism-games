#!/usr/bin/env ruby
# frozen_string_literal: true

# The game host. Settings: README "Settings" (a YAML file given by --config
# or ASTERISM_GAMES_CONFIG, and the environment).
#
#   bin/asterism-games [--config PATH]          # the host (tables, or the rooms' tables)
#   bin/asterism-games status [--idle] [URL]    # the rooms' host: what GET /status says
#                                               # (the rooms and the permanent tables);
#                                               # --idle: exit 0 when nobody sits at a table
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

if ARGV.first == "status"
  require "json"
  require "net/http"
  args = ARGV.drop(1)
  idle = args.delete("--idle")
  url = args.first || "http://127.0.0.1:#{(ENV['ASTERISM_GAMES_STATUS_LISTEN'] || ':7460')[/\d+\z/]}/status"
  begin
    s = JSON.parse(Net::HTTP.get(URI(url)))
  rescue StandardError => e
    warn "asterism-games status: #{url}: #{e.message}"
    exit 2
  end
  rooms = s["rooms"] || {}
  puts "asterism-games #{s['version']} since #{s['since']}: #{rooms.size} room(s) with tables (at most #{s['max']}), " \
       "RSS #{(s['rss_kb'].to_i / 1024.0).round(1)} MB"
  text = lambda do |r|
    tables = (r["tables"] || {}).map do |n, t|
      "#{n} #{t['st']} (#{t['humans']} seated, #{t['cpus']} CPU, #{t['members']} at the table)"
    end
    "#{r['state']}, #{tables.empty? ? 'no tables yet' : tables.join('; ')}"
  end
  rooms.each { |slot, r| puts "  room #{slot}: #{text.call(r)}" }
  if (perm = s["permanent"])
    puts "  permanent tables#{" (#{perm['node']})" if perm['node']}: #{text.call(perm)}"
  end
  if (ai = s["ai"])
    kinds = (ai["kinds"] || {}).map { |k, e| "#{k} #{e['calls']} (#{e['in'].to_i + e['cache_read'].to_i + e['cache_write'].to_i} in, #{e['out']} out tokens, $#{format('%.4f', e['usd'].to_f)}#{", #{e['failed']} failed" if e['failed']})" }
    puts "  AI players #{ai['date']}: #{ai['calls']} decisions, $#{format('%.4f', ai['usd'].to_f)} of $#{ai['limit_usd']}" \
         "#{" (#{kinds.join('; ')})" unless kinds.empty?}"
  end
  puts "  rooms waiting for a table: #{s['without_table'].join(', ')}" unless s["without_table"].to_a.empty?
  puts s["busy"] ? "busy: someone sits at a table" : "idle: nobody sits at a table"
  exit(s["busy"] ? 1 : 0) if idle
  exit 0
end

require "asterism_games"
require "asterism_games/mahjong"
require "asterism_games/othello"

path = ENV["ASTERISM_GAMES_CONFIG"]
if (i = ARGV.index("--config"))
  path = ARGV[i + 1]
end
$stdout.sync = true
config = AsterismGames::Config.load(path)
log = ->(m) { puts "#{Time.now.strftime('%H:%M:%S')} #{m}" }
host = config["rooms"] ? AsterismGames::Rooms.new(config, log: log) : AsterismGames::Host.new(config, log: log)
%w[INT TERM].each { |s| trap(s) { host.stop! } }
host.run
puts "games: stopped (state saved)"
