#!/usr/bin/env ruby
# frozen_string_literal: true

# An othello table in a terminal: kept for the scripts and the habits of
# before games 0.17.0. It is `asterism-games play othello` (README
# "Playing in a terminal"), with the same options:
#
#   bundle exec bin/othello-tty [--router tcp/127.0.0.1:7447] [--table games/games/othello1]
#                               [--name NAME] [--node NODE] [--credentials alice.tar]
#                               [--namespace room/01] [--commands "sit,cpu,start,auto"] [--until-over]
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "asterism_games/play"

exit AsterismGames::Play.main(["othello", *ARGV])
