#!/usr/bin/env ruby
# frozen_string_literal: true

# Players for trying a table without screens: N processes (one Asterism
# connection each), each joins the table as node bot-<host pid>-<i>, sits,
# and plays through the same calls a screen makes (view / act). The first
# fills the empty seats with CPUs and starts. They take a win when offered,
# call now and then, otherwise pass or discard the drawn tile, and go on to
# the next round. After --games games they leave the table (or on Ctrl-C).
#
#   bundle exec bin/mahjong-bots [--router tcp/127.0.0.1:7447] [--table games/games/mahjong2]
#                                [--players 4] [--think-ms 500] [--games 1] [--prefix bot-NAME]
#                                [--rules 0=1,1=0] [--result-ms 0] [--start-ms 0]
#                                [--credentials room-01.tar --namespace room/01]   # in a room
#                                [--credentials fmruby-aaaaaa.tar --node fmruby-aaaaaa]
#                                    # one player as a board with its own certificate
#                                    # (the permanent tables, README "Permanent tables")
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "asterism"
require "asterism_games/mahjong/engine"

E = AsterismGames::Mahjong::Engine
opts = { router: "tcp/127.0.0.1:7447", table: "games/games/mahjong2", players: 4, think: 500, games: 1,
         prefix: "bot-#{Process.pid}", rules: [], result_ms: 0, start_ms: 0 }
ARGV.each_slice(2) do |k, v|
  case k
  when "--router" then opts[:router] = v
  when "--table" then opts[:table] = v
  when "--players" then opts[:players] = v.to_i
  when "--think-ms" then opts[:think] = v.to_i
  when "--games" then opts[:games] = v.to_i
  when "--prefix" then opts[:prefix] = v
  when "--credentials" then opts[:credentials] = v
  when "--namespace" then opts[:namespace] = v
  when "--node" then opts[:node] = v
  when "--rules" then opts[:rules] = v.split(",").map { |kv| kv.split("=").map(&:to_i) }
  when "--result-ms" then opts[:result_ms] = v.to_i
  when "--start-ms" then opts[:start_ms] = v.to_i
  else abort "unknown option #{k}"
  end
end
$stdout.sync = true
opts[:players] = 1 if opts[:node] # one node ID, one player

def play(i, opts)
  node = opts[:node] || "#{opts[:prefix]}-#{i}"
  extra = {}
  extra[:credentials] = opts[:credentials] if opts[:credentials]
  extra[:config] = { "namespace" => opts[:namespace] } if opts[:namespace]
  Asterism.connect(opts[:credentials] ? nil : opts[:router], node: node, app: "game", **extra)
  t = Asterism[opts[:table], timeout: 3.0]
  tok = t.join("Bot#{i + 1}")["token"]
  sleep 0.5 * i
  r = t.sit(tok, -1)
  puts "#{node}: sit #{r}"
  rng = Random.new(i)
  calls = 0
  games = 0
  loop do
    if i.zero? && t.view(tok)["st"] == "wait"
      sleep 0.5 * opts[:players] + 0.5
      opts[:rules].each { |item, value| puts "#{node}: rule #{item}=#{value} #{t.rule(tok, item, value)}" }
      t.cpu(tok, -1, true)
      (opts[:start_ms] / 2000).times do # still here (a view every 2 s)
        sleep 2
        t.view(tok)
      end
      puts "#{node}: start #{t.start(tok)}"
    end
    sleep opts[:think] / 1000.0
    v = t.view(tok)
    break puts("#{node}: #{v['error']}") if v["error"]
    a = v["a"] || []
    if v["st"] == "over"
      puts "#{node}: over #{v['fin'].inspect}"
      games += 1
      break if games >= opts[:games]
      t.act(tok, v["sv"], E::NEXT, "".b) if a.any?
      sleep 1 until t.view(tok)["st"] != "over"
      next
    end
    next if a.empty?
    sleep opts[:result_ms] / 1000.0 if v["st"] == "result" && opts[:result_ms].positive?
    types = a.map(&:first)
    pick = if (w = a.find { |x, _| [E::TSUMO_AGARI, E::RON, E::NEXT].include?(x) }) then w
           elsif types.include?(E::PON) && rng.rand < 0.3 then a.find { |x, _| x == E::PON }
           elsif types.include?(E::SKIP) then [E::SKIP, "".b]
           elsif (d = a.find { |x, _| x == E::DAHAI })
             tile = v["dt"].to_i >= 0 ? v["dt"] : d[1].getbyte(d[1].bytesize - 1)
             [E::DAHAI, [tile].pack("C")]
           end
    next unless pick
    calls += 1
    t.act(tok, v["sv"], pick[0], pick[1])
  end
  puts "#{node}: #{calls} actions, leaves: #{t.leave(tok)}"
rescue Asterism::Error => e
  puts "#{node}: #{e.class}: #{e.message}"
  Asterism.close rescue nil
  sleep 3
  retry if (tries = (tries || 0) + 1) < 20
ensure
  Asterism.close rescue nil
end

pids = Array.new(opts[:players]) { |i| fork { play(i, opts) } }
puts "bots #{opts[:node] || "#{opts[:prefix]}-0..#{opts[:players] - 1}"} at #{opts[:table]}"
trap("INT") { pids.each { |p| Process.kill("TERM", p) rescue nil } }
pids.each { |p| Process.wait(p) }
