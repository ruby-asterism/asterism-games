# deploy/vps/.env of asterism-games: copy this file to .env and change what
# you need (docs/install.md). docker compose reads it for the ${...} of
# docker-compose.yml, and the host gets every line as its environment (so
# MAHJONG_* and ASTERISM_GAMES_* lines below reach it).

# The image: the published one, ghcr.io/ruby-asterism/asterism-games:<version>.
# update.sh writes the version it pulled. Building it here instead
# (docker-compose.build.yml, update.sh --build): a name of your own, e.g.
# GAMES_IMAGE=asterism-games-local, so a pull never replaces it.
GAMES_IMAGE=ghcr.io/ruby-asterism/asterism-games
GAMES_VERSION=0.12.0

# The console's compose project: its volume <project>_rooms and its network
# <project>_router are used by name.
ASTERISM_PROJECT=asterism

# Rooms with tables at once (one host process each) and the container's
# memory limit.
GAMES_ROOM_MAX=3
GAMES_MEM_LIMIT=384m

# The permanent tables (docs/install.md, "Permanent tables"): the host's own
# .tar from the console (a registry row with the role for the game host),
# put in credentials/ next to this file (chown 1000:1000, chmod 600). Without
# this line there are only the rooms' tables.
# ASTERISM_GAMES_PERMANENT_CREDENTIALS=/credentials/games.tar
# The rooms use the same certificate (a console 0.3.0 lists the host in
# rooms.json); for rooms only, without permanent tables, name it here instead:
# ASTERISM_GAMES_ROOM_CREDENTIALS=/credentials/games.tar
# Their names (comma separated; config/rooms.yml's unless said; a name finds
# its game, or say it: name:game):
# ASTERISM_GAMES_PERMANENT_TABLES=mahjong1,mahjong2,othello1

# The tables (README "Settings"; the defaults are in the README):
# MAHJONG_TURN_SECONDS=20
# MAHJONG_CALL_SECONDS=8
# MAHJONG_CPU_LEVEL=normal
# OTHELLO_TURN_SECONDS=0
# What a room's link must open for the room to get its game's table (comma separated):
# ASTERISM_GAMES_ROOM_APPS=/app/game/mahjong/mahjong.app.rb,/app/game/othello/othello.app.rb

# AI players (README "AI players"): a table's owner may seat Claude and Jev
# when their keys are here (keep this file chmod 600; the keys go nowhere
# else). Without a key, that AI player is not offered.
# ANTHROPIC_API_KEY=
# TYPESAFE_API_KEY=
# The most the AI players may cost a day (USD), and the decisions of one game:
# ASTERISM_GAMES_AI_DAILY_USD=3.0
# A kind's own daily limit (USD; games 0.15.0): when its own money of the
# day reaches it, only that kind stops (its seats are played by the CPU) and
# the others go on. A kind without one follows ASTERISM_GAMES_AI_DAILY_USD
# (the day's total of every kind). For example:
# ASTERISM_GAMES_AI_DAILY_USD_CLAUDE=10
# ASTERISM_GAMES_AI_DAILY_USD_JEV=2
# ASTERISM_GAMES_AI_CALLS_PER_GAME=400
# Their time for a move and for a call (seconds; the humans keep theirs):
# MAHJONG_AI_TURN_SECONDS=30
# MAHJONG_AI_CALL_SECONDS=15
# The models and the prices (USD per million tokens; the defaults are the
# published prices, Claude checked 2026-10-17, Jev 2026-10-18):
# ASTERISM_GAMES_CLAUDE_MODEL=claude-sonnet-5-5
# ASTERISM_GAMES_JEV_MODEL=jev-latest
# ASTERISM_GAMES_CLAUDE_USD_IN=2.0
# ASTERISM_GAMES_CLAUDE_USD_OUT=10.0
# ASTERISM_GAMES_CLAUDE_USD_CACHE_WRITE=2.5
# ASTERISM_GAMES_CLAUDE_USD_CACHE_READ=0.10
# ASTERISM_GAMES_JEV_USD_IN=0.042
